###
# @name dni con letra incorrecta (409 dni)
POST http://localhost:8080/users
Content-Type: application/json

{
  "name": "pablo",
  "email": "dni@email.com",
  "phone": "677000005",
  "rol": "admin",
  "dni": "23454234W"
}

###
# @name dni que rechaza el mock 99999999w (409 dni)
POST http://localhost:8080/users
Content-Type: application/json

{
  "name": "pablo",
  "email": "mock@email.com",
  "phone": "677000006",
  "rol": "admin",
  "dni": "99999999w"
}

###
# @name obtener usuario 1 (200)
GET http://localhost:8080/users/1

###
# @name obtener usuario 2 de la sala 2 (404)
GET http://localhost:8080/users/2

###
# @name obtener usuario inexistente (404)
GET http://localhost:8080/users/999

###
# @name obtener usuario con id no numerico (400)
GET http://localhost:8080/users/abc