# capgemini-users

###
# @name crear usuario admin (201, email)
POST http://localhost:8080/users
Content-Type: application/json

{
  "name": "pablo",
  "email": "email@email.com",
  "phone": "677998899",
  "rol": "admin",
  "dni": "23454234F"
}

###
# @name crear usuario superadmin (201, sms)
POST http://localhost:8080/users
Content-Type: application/json

{
  "name": "ana",
  "email": "ana@email.com",
  "phone": "655443322",
  "rol": "superadmin",
  "dni": "11111111H"
}

###
# @name nombre de mas de 6 caracteres (409 userName)
POST http://localhost:8080/users
Content-Type: application/json

{
  "name": "pablito",
  "email": "pablito@email.com",
  "phone": "677000001",
  "rol": "admin",
  "dni": "22222222J"
}

